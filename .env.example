# Copy this file to .env and fill in your own values.
# Get your API key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Get an Agent ID by creating an agent at https://elevenlabs.io/app/conversational-ai
AGENT_ID=your_default_agent_id_here
AGENT_NAME=Default Agent

# Optional: add up to two more agents to enable the "switch agents" dropdown.
# Leave these blank if you only want one agent.
AGENT_ID_2=
AGENT_NAME_2=

AGENT_ID_3=
AGENT_NAME_3=

# Optional: change the local port (defaults to 3000)
PORT=3000
